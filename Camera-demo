<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Camera Preview Demo</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      font-family: Arial;
      background: #f2f2f2;
      text-align: center;
      padding-top: 40px;
    }
    video {
      width: 300px;
      border-radius: 10px;
      border: 2px solid #333;
    }
    button {
      margin-top: 15px;
      padding: 10px 20px;
      font-size: 16px;
      cursor: pointer;
    }
  </style>
</head>
<body>

<h3>Camera Permission Demo</h3>
<p>Camera start करण्यासाठी Allow द्या</p>

<video id="video" autoplay></video><br>

<button onclick="startCamera()">Start Camera</button>

<script>
  function startCamera() {
    navigator.mediaDevices.getUserMedia({ video: true })
      .then(function(stream) {
        document.getElementById("video").srcObject = stream;
      })
      .catch(function(error) {
        alert("Camera permission denied किंवा error");
      });
  }
</script>

</body>
</html>
